# 镜像配置
IMAGE=ghcr.io/lemonzuo/homer:latest

# Docker 运行配置
HOST_PORT=8081
TZ=Asia/Shanghai
GIN_MODE=release

# MySQL 连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 服务端口
SERVER_PORT=8081

# 企业微信通知（生日提醒）
# 留空则关闭生日提醒推送，仅本地数据库存储
WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_SECRET=
# 可选：仅推送给特定标签下的成员；留空则推送给应用可见范围全员
WEWORK_TAG_ID=

# 阿里云 CDN（加速域名管理）
# 与 CAS 用独立 AK/SK；留空则 CDN 页面接口返回未配置
ALIYUN_CDN_ACCESS_KEY_ID=
ALIYUN_CDN_ACCESS_KEY_SECRET=

# 阿里云 CAS 数字证书管理
# 与 CDN 用独立 AK/SK；留空则 CAS 页面接口返回未配置
ALIYUN_CAS_ACCESS_KEY_ID=
ALIYUN_CAS_ACCESS_KEY_SECRET=

# ACME 自动签发
# 账号私钥、签发产物落盘目录；CA 账号/ZeroSSL EAB 存 acme_account 表，DNS 凭证存 acme_credential 表
ACME_DATA_DIR=./data/acme
# 证书剩余天数 ≤ 此阈值时自动续期
ACME_RENEW_BEFORE_DAYS=30
# 每日自动续期检查 cron（6 段）
ACME_RENEW_CRON=0 0 3 * * *

# 调度
# robfig/cron v3 表达式（6 段：秒 分 时 日 月 周）。留空则不启动生日提醒。
BIRTHDAY_REMIND_CRON=0 0 9 * * *

# 12306Bypass 分流抢票助手 webhook 转发（POST /api/byPass/receive）
# 与生日提醒分开的独立企业微信应用；任一组留空则跳过对应通道
BYPASS_WEWORK_CORP_ID=
BYPASS_WEWORK_AGENT_ID=
BYPASS_WEWORK_SECRET=
BYPASS_WEWORK_TAG_ID=

# Resend 邮件（与 bypass 共用；后续其他模块可复用 RESEND_API_KEY）
RESEND_API_KEY=
# 发件人（需在 Resend 已验证的域下），收件人留空则不发邮件
BYPASS_EMAIL_FROM=
BYPASS_EMAIL_TO=
BYPASS_EMAIL_SUBJECT=分流通知
