# 镜像配置
IMAGE=ghcr.io/lemonzuo/homer:latest

# Docker 运行配置
HOST_PORT=8081
TZ=Asia/Shanghai
GIN_MODE=release

# MySQL 连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 服务端口
SERVER_PORT=8081

# 企业微信通知（生日提醒）
# 留空则关闭生日提醒推送，仅本地数据库存储
WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_SECRET=
# 可选：仅推送给特定标签下的成员；留空则推送给应用可见范围全员
WEWORK_TAG_ID=

# 阿里云 CDN（加速域名管理）
# 与 CAS 用独立 AK/SK；留空则 CDN 页面接口返回未配置
ALIYUN_CDN_ACCESS_KEY_ID=
ALIYUN_CDN_ACCESS_KEY_SECRET=

# 调度
# robfig/cron v3 表达式（6 段：秒 分 时 日 月 周）。留空则不启动生日提醒。
BIRTHDAY_REMIND_CRON=0 0 9 * * *
