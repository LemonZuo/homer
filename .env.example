# 镜像配置
IMAGE=ghcr.io/lemonzuo/homer:latest

# Docker 运行配置
HOST_PORT=8081
TZ=Asia/Shanghai
GIN_MODE=release

# MySQL 连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 服务端口
SERVER_PORT=8081

# 日志级别：debug | info | warn | error（默认 info）。仅控制台输出，不落文件。
LOG_LEVEL=info

# 生日提醒 cron（robfig/cron v3 6 段：秒 分 时 日 月 周）。留空则不启动。
BIRTHDAY_REMIND_CRON=0 0 9 * * *

# 事项提醒 cron（6 段）。留空则不启动。
EVENT_REMIND_CRON=0 0 9 * * *

# 阿里云 CDN（加速域名管理）
# 与 CAS 用独立 AK/SK；留空则 CDN 页面接口返回未配置
ALIYUN_CDN_ACCESS_KEY_ID=
ALIYUN_CDN_ACCESS_KEY_SECRET=

# 阿里云 CAS 数字证书管理
# 与 CDN 用独立 AK/SK；留空则 CAS 页面接口返回未配置
ALIYUN_CAS_ACCESS_KEY_ID=
ALIYUN_CAS_ACCESS_KEY_SECRET=

# ACME 自动签发
# 账号私钥、签发产物落盘目录；CA 账号/ZeroSSL EAB 存 acme_account 表，DNS 凭证存 acme_credential 表
ACME_DATA_DIR=./data/acme
# 证书剩余天数 ≤ 此阈值时自动续期
ACME_RENEW_BEFORE_DAYS=30
# 每日自动续期检查 cron（6 段）
ACME_RENEW_CRON=0 0 3 * * *
# 证书密钥类型：ec256 | ec384 | rsa2048 | rsa3072 | rsa4096 | rsa8192（默认 ec256）
ACME_KEY_TYPE=ec256
# 部署任务失败重试（仅持久化部署配置触发的任务参与；临时部署不重试）
# 允许总执行次数（含首次），1=不重试
ACME_DEPLOY_RETRY=3
# 退避基数秒，实际间隔 = 基数 * 已执行次数
ACME_DEPLOY_RETRY_BACKOFF_SEC=10
# 扫描待重试任务的 cron（6 段，默认每分钟）
ACME_DEPLOY_RETRY_CRON=0 * * * * *

# 调度器失败告警阈值：任务连续失败达此次数才推送告警（默认 1=每次失败都告警）
SCHEDULER_ALERT_FAIL_THRESHOLD=1

# SSH 监控维护窗口(日内 HH:MM-HH:MM，本地时区)。窗口内跳过 UPS/ESXi 定时采样，避免路由器定时重启造成离线误报；留空或 off 禁用。
SSH_MONITOR_MAINTENANCE_WINDOW=04:25-04:35

# UPS 监控
# 采样 cron(6 段,默认每 30 秒一次)。机器从 acme_deploy_target 取 kind in (ssh,fnos) 且 ups_monitor='1' 的目标
UPS_SAMPLE_CRON=*/30 * * * * *
# 清理 cron(6 段,默认每天凌晨 4 点)
UPS_CLEANUP_CRON=0 0 4 * * *
# ups_sample 保留天数(默认 7 天)
UPS_RETENTION_DAYS=7
# 单台机器采样的 SSH 超时秒数(实际整体上限为 dial+timeout,默认 5+15)
UPS_SSH_TIMEOUT_SEC=5
# UPS 设备失联告警去抖:单台 UPS reading 连续失败几轮才报"已失联"(默认 3 ≈ 90s)
UPS_OFFLINE_THRESHOLD=3
# 主机 NUT 不可用告警去抖:`upsc -l` 连续失败几轮才报"NUT 不可用"(默认 5 ≈ 150s,
# 比 UPS 阈值宽,扛 homer/fnOS 间网络瞬抖、homer 自身 GC 卡顿等共因)
UPS_NUT_OFFLINE_THRESHOLD=5

# ESXi 监控
# 采样 cron(6 段,默认每 30 秒一次)。如上一轮仍在执行,调度器会跳过本轮避免重叠
ESXI_SAMPLE_CRON=*/30 * * * * *
# 清理 cron(6 段,默认每天凌晨 4 点)
ESXI_CLEANUP_CRON=0 0 4 * * *
# esxi_sample 保留天数(默认 7 天)
ESXI_RETENTION_DAYS=7
# 单台 ESXi 采样的 SSH 超时秒数。ESXi 命令偶发慢返回,需要给重试/补采留空间
ESXI_SSH_TIMEOUT_SEC=120
# ESXi 状态告警阈值。连续达到/超过阈值 N 次才推送,持续超阈值不重复
ESXI_ALERT_CONSECUTIVE_SAMPLES=5
# CPU 最高核温度(°C)
ESXI_ALERT_CPU_TEMP_C=85
# CPU 使用率(%)
ESXI_ALERT_CPU_USAGE_PERCENT=90
# 内存使用率(%)
ESXI_ALERT_MEMORY_USAGE_PERCENT=90
# 单盘 SMART 温度(°C)
ESXI_ALERT_DISK_TEMP_C=55
# 单盘 datastore 使用率(%)
ESXI_ALERT_DISK_USAGE_PERCENT=90
